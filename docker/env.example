# Copy to .env at the repository root; use absolute paths on your data volume.
WECHAT_CONFIG_DIR=./private/config
WECHAT_INPUT_DIR=./private/input
WECHAT_DATA_DIR=./collection_results
# External adapter files, verified against their pinned source hashes.
# Only discovery mounts it, read-only; it is never copied into the image.
MINICRAWLER_DIR=./private/dependencies/MiniCrawler
# On macOS/Linux, set these to `id -u` and `id -g` for bind-mount permissions.
LOCAL_UID=1000
LOCAL_GID=1000
# Appium runs in its own container. Use --appium-url when changing this port.
APPIUM_PORT=4723
# Linux USB override only: persistent authorization keys, excluded from Git.
ADB_KEYS_DIR=./private/adb
