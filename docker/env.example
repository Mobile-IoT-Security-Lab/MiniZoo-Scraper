# Copy to .env at the repository root; use absolute paths on your data volume.
WECHAT_CONFIG_DIR=./private/config
WECHAT_INPUT_DIR=./private/input
WECHAT_DATA_DIR=./collection_results
# Explicit external dependency, checked against the pinned submodule revision.
# Only discovery mounts it, read-only; it is never copied into the image.
MINICRAWLER_DIR=./scraper/MiniCrawler
# On macOS/Linux, set these to `id -u` and `id -g` for bind-mount permissions.
LOCAL_UID=1000
LOCAL_GID=1000
