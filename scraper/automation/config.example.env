# Copy to config.local.env (ignored), edit, then export with:
# set -a; . automation/config.local.env; set +a

# Real ADB serials belong only in the local copy of this file.
WECHAT_DEVICES='DEVICE_A,DEVICE_B'

# Defaults resolve from the source location, independently of the launch folder:
# WECHAT_ROOT='/path/to/MiniZooScraper/scraper'
# WECHAT_DATA_DIR='/path/to/MiniZooScraper/collection_results/initial'
# WECHAT_STATE_DIR='/path/to/MiniZooScraper/collection_results/automation'
# WECHAT_DISCOVERY_DB='/path/to/MiniZooScraper/collection_results/discovery/data.db'

# Optional removable-volume guard: must be an actual mounted volume.
# WECHAT_REQUIRED_MOUNT='/path/to/mounted-volume'

# Source runs are always retained for provenance and recovery.
# Optional Hermes integration; leave empty for built-in periodic local merges.
WECHAT_HERMES_CRON_IDS=''
